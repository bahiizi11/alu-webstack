#!/usr/bin/env bash
# Displays information about subdomains (record type and destination)

print_info() {
    dig "$2.$1" | grep -A1 'ANSWER SECTION:' | tail -1 | awk -v name="$2" '{print "The subdomain " name " is a " $4 " record and points to " $5}'
}

if [ -n "$2" ]; then
    print_info "$1" "$2"
else
    for sub in www lb-01 web-01 web-02; do
        print_info "$1" "$sub"
    done
fi
